{
	"name": "figfig",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"dev": "tauri dev",
		"dev:ui": "vite --host 127.0.0.1",
		"specs": "tsx scripts/build-specs.ts",
		"specs:check": "tsx scripts/build-specs.ts --check",
		"build": "pnpm run specs && tsc --noEmit && vite build",
		"check": "tsc --noEmit && pnpm run specs:check",
		"test": "vitest run",
		"tauri": "tauri",
		"build:popup": "tauri build --bundles app",
		"build:release": "pnpm run build:popup -- --locked && cargo build --release --locked -p figfig-cli",
		"test:shell": "python3 -m unittest discover -s tests -p '*_test.py' -v",
		"docs:dev": "pnpm --dir website start",
		"docs:check": "pnpm --dir website typecheck",
		"docs:build": "pnpm --dir website build",
		"docs:serve": "pnpm --dir website serve"
	},
	"dependencies": {
		"@tauri-apps/api": "~2.12.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.12.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.12",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"jsdom": "^31.0.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": "^24.15.0 || >=26.0.0"
	}
}
